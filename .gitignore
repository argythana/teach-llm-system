mlruns/
mlflow.db
**/*.npy

# Secrets and per-machine config
.env
.env.*
!.env.example
.envrc

# Claude Code: keep only shared skills
.claude/*
!.claude/skills/

# Executed-notebook scratch output from tools/run_all.py
_executed/

